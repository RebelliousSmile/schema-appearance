{
  "name": "schema-appearance",
  "version": "0.1.0",
  "description": "Open, versioned schemas for cross-game presentation packs.",
  "scripts": {
    "gen": "tsx tools/gen-schemas.ts",
    "validate": "tsx tools/validate-examples.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run gen && npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-appearance.git"
  },
  "keywords": [
    "appearance",
    "game-pack",
    "JSON Schema",
    "Zod",
    "interoperable"
  ],
  "author": "RebelliousSmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-appearance/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-appearance#readme",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  }
}
